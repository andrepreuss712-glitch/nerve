# ── NERVE Staging .env ─────────────────────────────────────────────────────
# Vorlage fuer /etc/nerve/.env auf dem Staging-Server.
# WICHTIG: Diese Datei mit echten Werten befuellen und als /etc/nerve/.env
# auf dem Staging-Server ablegen (SSH). NIEMALS echte Keys committen!
#
# Erstellen: ssh -i ~/.ssh/nerve_staging root@<STAGING_IP>
#            nano /etc/nerve/.env
# Kopiere diesen Inhalt und ersetze alle Platzhalter.

# ── KI-APIs (Staging-Sandbox-Keys — NICHT Production-Keys verwenden) ──────
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE-WITH-STAGING-SANDBOX-KEY
DEEPGRAM_API_KEY=REPLACE-WITH-STAGING-DEEPGRAM-KEY

# ── Stripe (Test-Mode — sk_test_ Prefix ist Pflicht fuer Staging) ─────────
STRIPE_SECRET_KEY=sk_test_REPLACE-WITH-STRIPE-TEST-SECRET-KEY
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE-WITH-STRIPE-TEST-PUBLISHABLE-KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE-WITH-STRIPE-TEST-WEBHOOK-SECRET

# ── HTTP-Basic-Auth fuer Staging-nginx (Req-8) ────────────────────────────
# Generieren: openssl rand -hex 12
STAGING_BASIC_AUTH_USER=staging
STAGING_BASIC_AUTH_PASS=REPLACE-WITH-GENERATED-PASSWORD

# ── Datenbank (Postgres auf Staging-Server, Peer-Auth) ────────────────────
DATABASE_URL=postgresql://nerve_app@/nerve

# ── Flask ─────────────────────────────────────────────────────────────────
FLASK_ENV=production
SECRET_KEY=REPLACE-WITH-RANDOM-SECRET-KEY-min-32-chars

# ── CSRF (Staging: aktiv, wie Production) ────────────────────────────────
# WTF_CSRF_ENABLED=False  # NICHT setzen auf Staging — nur lokal

# ── Weitere Vars (analog .env.example) ───────────────────────────────────
# Alle weiteren Variablen die in .env.example stehen hier ebenfalls setzen.
# Pruefen: grep "os.environ.get" config.py
