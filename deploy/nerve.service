# ── NERVE systemd Service Unit ───────────────────────────────────────────────
# Copy to: /etc/systemd/system/nerve.service
# Enable:  sudo systemctl daemon-reload && sudo systemctl enable nerve
# Start:   sudo systemctl start nerve
# Logs:    sudo journalctl -u nerve -f

[Unit]
Description=NERVE Sales Assistant (gunicorn)
After=network.target

[Service]
Type=simple
User=nerve_app
Group=nerve_app
WorkingDirectory=/opt/nerve/app

# Environment — secrets live in /etc/nerve/.env (not in repo)
# Phase 08: Optional PROMPT_EWB_VERSION_OVERRIDE fuer A/B-Override (siehe .env.example)
# Leer = A/B-Routing aktiv; gesetzt = forciert alle User auf angegebene Variante.
EnvironmentFile=/etc/nerve/.env

# gunicorn with gthread worker class (required for Flask-SocketIO threading mode)
# 1 worker + 64 threads (Phase 08.23.2.STABIL-1). Host gemessen 2026-07-23:
# 4 vCPU / 7.7 GB (der frühere "CX22, 2 vCPU, 4 GB"-Kommentar war stale).
# Bei async_mode='threading' belegt JEDE WS-Verbindung einen Thread fuer die
# gesamte Anruf-Dauer -> 4 Threads = max ~3 parallele Anrufe.
# KEINE zusaetzlichen Worker (>1) ohne Socket.IO-message_queue + Sticky-Sessions:
# jeder Worker haette eigene In-Memory-Rooms -> die Rooms zerreissen.
# Der DB-Pool ist in database/db.py mitgezogen (sonst wandert der Engpass nur dorthin).
ExecStart=/opt/nerve/venv/bin/gunicorn \
    --worker-class gthread \
    --workers 1 \
    --threads 64 \
    --bind 127.0.0.1:8000 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile - \
    app:app

# Restart policy
Restart=always
RestartSec=5s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
